{
  "name": "MAT120 Lean environment",
  "build": { "dockerfile": "Dockerfile" },
  "onCreateCommand": "lake exe cache get!",
  "postCreateCommand": "lake build",
  "customizations": {
    "vscode": {
      "extensions": ["leanprover.lean4"],
      "settings": {
        "editor.wordWrap": "on",
        "chat.disableAIFeatures": true
      }
    },
    "codespaces": {
      "openFiles": ["MAT120/Welcome.lean"]
    }
  },
  "hostRequirements": { "cpus": 4 }
}
